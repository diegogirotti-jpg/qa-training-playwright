{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "playwright.diagnostic.config.ts",
    "playwright.diagnostic-unit.config.ts",
    "diagnostics/**/*.ts"
  ]
}
