{
  "name": "qa-training-playwright",
  "version": "1.0.0",
  "description": "Proyecto para los ejercicios de automatizaci\u00f3n del path de Santex.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:toolshop": "playwright test e2e/toolshop e2e/api --project=chromium --workers=1 --retries=0",
    "test:ui:no-login": "playwright test e2e/toolshop/cart.spec.ts e2e/toolshop/search.spec.ts e2e/toolshop/catalog.spec.ts --project=chromium --workers=1 --retries=0",
    "test:api": "playwright test e2e/api --project=chromium --workers=1 --retries=0",
    "test:list": "playwright test e2e/toolshop e2e/api --project=chromium --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "diagnose": "playwright test --config=playwright.diagnostic.config.ts",
    "diagnose:list": "playwright test --config=playwright.diagnostic.config.ts --list",
    "diagnose:report": "playwright show-report diagnostic-output/playwright-report",
    "test:diagnostic-unit": "playwright test --config=playwright.diagnostic-unit.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
